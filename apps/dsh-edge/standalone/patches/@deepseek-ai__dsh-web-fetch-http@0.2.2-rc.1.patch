+const LOCAL_SUFFIXES = ['.localhost', '.local', '.localdomain', '.internal', '.home.arpa'];
+function isIpLiteral(hostname) {
+	if (/^\d{1,3}(\.\d{1,3}){3}$/.test(hostname)) return true;
+	if (hostname.startsWith('[') && hostname.endsWith(']')) return true;
+	return false;
+}
+function isLocalHostname(hostname) {
+	const lower = hostname.toLowerCase();
+	if (lower === 'localhost') return true;
+	if (LOCAL_SUFFIXES.some(suffix => lower.endsWith(suffix))) return true;
+	return false;
+}
+function assertPublicFetchTarget(url) {
+	const hostname = typeof url === 'string' ? new URL(url).hostname : url.hostname;
+	if (isIpLiteral(hostname)) throw new WebError(`fetch blocked: IP literal "${hostname}" is not allowed`, "WEB_BLOCKED_URL");
+	if (isLocalHostname(hostname)) throw new WebError(`fetch blocked: local hostname "${hostname}" is not allowed`, "WEB_BLOCKED_URL");
+}
