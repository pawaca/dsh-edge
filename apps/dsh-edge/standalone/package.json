{
  "name": "dsh-edge-standalone-assembly",
  "private": true,
  "description": "Pinned release assembly for dsh-edge Web and Cloudflare Worker artifacts",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:workers",
    "build:edge-client": "tsdown --config tsdown.edge-client.config.mjs",
    "build:web": "pnpm run build:edge-client && node scripts/assemble-standalone-web.mjs",
    "build:worker:direct": "node scripts/bundle-standalone.mjs direct",
    "build:worker:isolated": "node scripts/bundle-standalone.mjs isolated",
    "build:workers": "pnpm run build:worker:direct && pnpm run build:worker:isolated",
    "verify": "node scripts/verify-determinism.mjs && node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.0",
    "@deepseek-ai/cordis": "4.0.1",
